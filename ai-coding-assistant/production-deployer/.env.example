# Independent production deployer. Keep this file/service isolated from the AI backend.
PRODUCTION_DEPLOYER_DATABASE_PATH=/data/production-deployer.db
PRODUCTION_DEPLOYER_EXECUTION_ENABLED=false
PRODUCTION_DEPLOYER_PACKAGE_SIGNING_KEY=
PRODUCTION_DEPLOYER_RECEIPT_SIGNING_KEY=
PRODUCTION_DEPLOYER_EXPECTED_AUDIENCE=independent-production-deployer
PRODUCTION_DEPLOYER_OPERATOR_CREDENTIALS_JSON={}
PRODUCTION_DEPLOYER_ALLOWED_OPERATOR_ROLES=release-manager,ops,deployer
PRODUCTION_DEPLOYER_MIN_APPROVALS=2
PRODUCTION_DEPLOYER_REQUIRED_APPROVAL_ROLES=release-manager,ops
PRODUCTION_DEPLOYER_ALLOWED_PROVIDERS=kubernetes,ecs,external
PRODUCTION_DEPLOYER_AUTO_ROLLBACK_ENABLED=true
PRODUCTION_DEPLOYER_MIN_AVAILABILITY=99.0
PRODUCTION_DEPLOYER_MAX_ERROR_RATE=1.0
PRODUCTION_DEPLOYER_MAX_P95_MS=2500
PRODUCTION_DEPLOYER_COMMAND_TIMEOUT_SECONDS=900
PRODUCTION_DEPLOYER_OUTCOME_CALLBACK_URL=
PRODUCTION_DEPLOYER_CALLBACK_TIMEOUT_SECONDS=5
PRODUCTION_DEPLOYER_ALLOW_HTTP_CALLBACK=false
PRODUCTION_DEPLOYER_SECRETS_DIR=/run/production-deployer-secrets

# Part 16 hardening / rotation / certification
PRODUCTION_DEPLOYER_PREVIOUS_PACKAGE_SIGNING_KEYS=
PRODUCTION_DEPLOYER_PREVIOUS_RECEIPT_SIGNING_KEYS=
PRODUCTION_DEPLOYER_SLO_WINDOW_MIN_SAMPLES=3
PRODUCTION_DEPLOYER_SLO_WINDOW_PASS_RATIO=1.0
PRODUCTION_DEPLOYER_AUDIT_CHAIN_REQUIRED=true
PRODUCTION_DEPLOYER_MAX_CONCURRENT_ACTIVE=10
PRODUCTION_DEPLOYER_CERTIFICATION_MODE=false
