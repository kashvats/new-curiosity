# Backend configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_HOST=qdrant
QDRANT_PORT=6333
APP_DATABASE_PATH=/data/app.db
UPLOAD_DIR=/data/uploads
EXTRACTED_DIR=/data/extracted
EMBEDDING_MODEL=nomic-embed-text
QDRANT_COLLECTION=knowledge_chunks

# Models
CHAT_MODEL=qwen2.5-coder:7b
PLANNER_MODEL=qwen3:4b
CODER_MODEL=qwen2.5-coder:7b
RAG_TOP_K=6
MAX_PLAN_PHASES=12
MAX_CODE_CONTEXT_FILES=8
MAX_CODE_FILE_CHARS=12000

# Workspace
WORKSPACE_ROOT=/workspace/project
BACKUP_DIR=/workspace/backups
MAX_REVIEW_FILES=10

# Web Search & Browser
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://host.docker.internal:8080
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=20
BROWSER_HEADLESS=true
BROWSER_SCREENSHOT_DIR=/data/screenshots
BROWSER_TIMEOUT_SECONDS=30
BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Batch uploads
BATCH_UPLOAD_MAX_FILES=150
BATCH_UPLOAD_MAX_TOTAL_MB=1000

# Generated Docs
GENERATED_DOCS_DIR=/workspace/generated_docs

# Auth
ENABLE_API_KEY_AUTH=false
LOCAL_API_KEY=

# OCR (Phase 43) — optional, requires pdf2image + pytesseract + Tesseract binary
OCR_ENABLED=false
OCR_OUTPUT_DIR=/data/ocr
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS_PER_PAGE=50
OCR_SCANNED_PAGE_RATIO_THRESHOLD=0.6

# Reranking (Phase 46) — optional post-retrieval scoring
# RERANK_MODEL: Ollama model name to score relevance (empty = fast fallback scoring)
RERANK_ENABLED=false
RERANK_MODEL=
RERANK_TOP_N=6
RERANK_CANDIDATE_LIMIT=30

# Agent / self-improvement safety
DEBUGGER_MODEL=qwen2.5-coder:7b
REVIEWER_MODEL=qwen2.5-coder:7b
MAX_REPAIR_ATTEMPTS=4
MAX_PATCH_FILES=12
MAX_PATCH_BYTES=500000
COMMAND_TIMEOUT_SECONDS=120
MAX_COMMAND_OUTPUT_CHARS=40000
AGENT_ALLOWED_EXECUTABLES=python,python3,pytest,npm,git,ruff,mypy

AGENT_PROTECTED_PATHS=.env,.git/,data/ai_coder.db

# Part 4 manual improvement controller
IMPROVEMENT_DEFAULT_POLICY=manual
IMPROVEMENT_ALLOWED_RISKS=low,medium
IMPROVEMENT_MAX_CANDIDATES=8
IMPROVEMENT_MAX_FILES=8
IMPROVEMENT_ACCEPTABLE_HEALTH_SCORE=92
IMPROVEMENT_MIN_PRIORITY=0.05
IMPROVEMENT_MAX_SCORE_REGRESSION=3
IMPROVEMENT_SOURCE_SCAN_FILES=400
IMPROVEMENT_SOURCE_SCAN_BYTES=2000000
IMPROVEMENT_MIN_LEARNING_SAMPLES=3
IMPROVEMENT_HISTORY_LIMIT=200
IMPROVEMENT_EXPERIMENT_MAX_CANDIDATES=3
IMPROVEMENT_MAX_CYCLE_REPAIRS=3
IMPROVEMENT_MAX_CYCLE_ATTEMPTS=8
IMPROVEMENT_MAX_CYCLE_CHANGED_FILES=16
IMPROVEMENT_MAX_CYCLE_PATCH_BYTES=600000

# Part 6 governance / repetition / impact memory
IMPROVEMENT_REPEAT_LIMIT=2
IMPROVEMENT_REPEAT_HISTORY_LIMIT=50
IMPROVEMENT_POLICY_MAX_REQUIRED_PATHS=100
IMPROVEMENT_POLICY_MAX_PROTECTED_ROUTES=200
IMPROVEMENT_GOVERNANCE_MAX_MODULE_LINES=1200
IMPROVEMENT_TEST_IMPACT_HISTORY_LIMIT=200
# Part 7 autonomy-readiness / policy integrity / approvals / cooldowns
# Set a strong local secret to HMAC-sign every cycle policy snapshot.
IMPROVEMENT_POLICY_SIGNING_KEY=
# JSON object: {"alice":{"role":"maintainer","token":"replace-me"}}
IMPROVEMENT_APPROVER_CREDENTIALS_JSON={}
IMPROVEMENT_COOLDOWN_VALIDATION_HOURS=2
IMPROVEMENT_COOLDOWN_GOVERNANCE_HOURS=12
IMPROVEMENT_COOLDOWN_BUDGET_HOURS=1
IMPROVEMENT_COOLDOWN_ROLLBACK_HOURS=24
IMPROVEMENT_RISK_ESCALATION_FAILURES=2
IMPROVEMENT_READINESS_MIN_HEALTH=85
IMPROVEMENT_READINESS_MIN_COVERAGE=70
IMPROVEMENT_READINESS_MIN_DEPENDENCY_SCORE=85
IMPROVEMENT_READINESS_MIN_SUCCESSFUL_CYCLES=3
IMPROVEMENT_READINESS_MAX_ROLLBACK_RATE=0.10
IMPROVEMENT_READINESS_LOOKBACK=20

IMPROVEMENT_COVERAGE_MAX_REPORT_BYTES=2000000

# Part 8 dry-run guarded scheduler / CI+SLO evidence
# Background polling is OFF by default. Even when enabled, scheduled source apply remains disabled.
IMPROVEMENT_DRY_RUN_SCHEDULER_ENABLED=false
IMPROVEMENT_SCHEDULER_POLL_SECONDS=60
IMPROVEMENT_SCHEDULER_LEASE_TTL_SECONDS=300
IMPROVEMENT_SCHEDULER_MIN_INTERVAL_MINUTES=15
IMPROVEMENT_SCHEDULER_MAX_GLOBAL_RUNS_PER_HOUR=10
IMPROVEMENT_SCHEDULER_MAX_PROJECT_RUNS_PER_DAY=4
IMPROVEMENT_SCHEDULER_MAX_SCHEDULES_PER_PROJECT=20
IMPROVEMENT_SCHEDULER_CI_MAX_AGE_MINUTES=1440
IMPROVEMENT_SCHEDULER_SLO_MAX_AGE_MINUTES=120
IMPROVEMENT_SCHEDULER_SLO_MIN_ERROR_BUDGET=20
IMPROVEMENT_SCHEDULER_SLO_MIN_AVAILABILITY=99
IMPROVEMENT_SCHEDULER_SLO_MAX_ERROR_RATE=1
IMPROVEMENT_SCHEDULER_SLO_MAX_P95_MS=2500
IMPROVEMENT_SCHEDULER_CANARY_MIN_HEALTH=80
# Optional shared secret required on X-Improvement-Webhook-Token for CI/SLO ingestion.
IMPROVEMENT_EVIDENCE_WEBHOOK_TOKEN=
IMPROVEMENT_EVIDENCE_MAX_BYTES=1000000

# Part 9 production scheduler hardening
# Prefer signed HMAC evidence deliveries over the legacy shared-token header.
IMPROVEMENT_EVIDENCE_WEBHOOK_SIGNING_SECRET=
IMPROVEMENT_EVIDENCE_WEBHOOK_MAX_SKEW_SECONDS=300
# JSON object: {"ops":{"role":"release-manager","token":"replace-me"}}
IMPROVEMENT_OPERATOR_CREDENTIALS_JSON={}
IMPROVEMENT_SCHEDULER_ALERT_RETENTION_DAYS=30
IMPROVEMENT_SCHEDULER_TELEMETRY_RETENTION_DAYS=30
IMPROVEMENT_SCHEDULER_STAGING_MIN_INTERVAL_MINUTES=30
IMPROVEMENT_SCHEDULER_PROD_MIN_INTERVAL_MINUTES=60

# Part 10 deployment / operations hardening
# HA coordination: sqlite (default/local), redis, or postgres.
IMPROVEMENT_SCHEDULER_LEASE_BACKEND=sqlite
IMPROVEMENT_SCHEDULER_REDIS_URL=
IMPROVEMENT_SCHEDULER_REDIS_PREFIX=ai-coding-assistant:scheduler
IMPROVEMENT_SCHEDULER_POSTGRES_DSN=
IMPROVEMENT_SCHEDULER_LEADER_ELECTION_ENABLED=true
IMPROVEMENT_SCHEDULER_LEADER_LEASE_TTL_SECONDS=120

# Optional external alert webhook. HTTPS is required unless explicitly relaxed.
IMPROVEMENT_ALERT_WEBHOOK_URL=
IMPROVEMENT_ALERT_WEBHOOK_SIGNING_SECRET=
IMPROVEMENT_INTEGRATION_ALLOW_HTTP=false
IMPROVEMENT_INTEGRATION_HTTP_TIMEOUT_SECONDS=5

# Optional OTLP/HTTP log export. Endpoint should be collector base URL.
IMPROVEMENT_OTEL_EXPORTER_ENDPOINT=
IMPROVEMENT_OTEL_EXPORTER_HEADERS_JSON={}

# Native CI provenance adapters.
IMPROVEMENT_GITHUB_WEBHOOK_SECRET=
IMPROVEMENT_GITLAB_WEBHOOK_TOKEN=

# Control-plane retention and DR drill storage.
IMPROVEMENT_WEBHOOK_DELIVERY_RETENTION_DAYS=30
IMPROVEMENT_OPERATOR_AUDIT_RETENTION_DAYS=180
IMPROVEMENT_SCHEDULER_RUN_RETENTION_DAYS=90
IMPROVEMENT_INTEGRATION_DELIVERY_RETENTION_DAYS=30
IMPROVEMENT_SCHEDULER_DR_DIR=../data/scheduler-drills

# Part 11 deployment packaging / integration reliability
IMPROVEMENT_SECRETS_PROVIDER=env
IMPROVEMENT_SECRETS_DIR=/run/secrets
IMPROVEMENT_INTEGRATION_MAX_ATTEMPTS=5
IMPROVEMENT_INTEGRATION_BACKOFF_BASE_SECONDS=30
IMPROVEMENT_INTEGRATION_BACKOFF_MAX_SECONDS=3600
IMPROVEMENT_GITHUB_STATUS_TOKEN=
IMPROVEMENT_GITLAB_STATUS_TOKEN=
IMPROVEMENT_GITLAB_API_BASE=https://gitlab.com/api/v4
IMPROVEMENT_SCHEDULER_DR_BACKUP_KEEP=10
IMPROVEMENT_SCHEDULER_TRACE_RETENTION_DAYS=14
IMPROVEMENT_PROBE_REQUIRE_COORDINATION=true

# Part 12 candidate-to-staging release orchestration
# Production promotion is intentionally unavailable.
IMPROVEMENT_RELEASE_ROOT=/data/releases
IMPROVEMENT_RELEASE_BUILD_MODE=validate_only
IMPROVEMENT_RELEASE_REQUIRE_CONTAINER_BUILD=false
IMPROVEMENT_RELEASE_DOCKER_NETWORK=none
IMPROVEMENT_RELEASE_BUILD_TIMEOUT_SECONDS=900
IMPROVEMENT_RELEASE_PREVIEW_PROVIDER=none
IMPROVEMENT_RELEASE_PREVIEW_TTL_HOURS=24
IMPROVEMENT_RELEASE_SIGNING_KEY=
IMPROVEMENT_RELEASE_REQUIRE_SIGNATURE=true
IMPROVEMENT_RELEASE_REQUIRE_VULNERABILITY_REPORT=true
IMPROVEMENT_RELEASE_MAX_CRITICAL_VULNS=0
IMPROVEMENT_RELEASE_MAX_HIGH_VULNS=0
IMPROVEMENT_RELEASE_MAX_MEDIUM_VULNS=20
IMPROVEMENT_RELEASE_VULN_SCANNER=report_only
IMPROVEMENT_RELEASE_VULN_REPORT_MAX_BYTES=4000000
IMPROVEMENT_RELEASE_WORKSPACE_TTL_HOURS=48
# Part 13 staging providers / release handoff
IMPROVEMENT_STAGING_EXECUTION_ENABLED=false
IMPROVEMENT_STAGING_CI_TRIGGER_ENABLED=false
IMPROVEMENT_STAGING_OCI_EXECUTION_ENABLED=false
IMPROVEMENT_STAGING_PRODUCTION_DENY_TOKENS=prod,production
IMPROVEMENT_STAGING_GITHUB_WORKFLOW=staging.yml
IMPROVEMENT_GITHUB_ACTIONS_TOKEN=
IMPROVEMENT_GITLAB_PIPELINE_TOKEN=
IMPROVEMENT_RELEASE_COSIGN_ENABLED=false
IMPROVEMENT_STAGING_AUTO_TEARDOWN_EXPIRED=false
IMPROVEMENT_PRODUCTION_REQUEST_REQUIRE_VERIFIED_OPERATOR=true
IMPROVEMENT_PRODUCTION_REQUEST_ALLOWED_ROLES=release-manager,maintainer


# Part 14 production release governance plane
# This plane creates signed, credential-free packages for an independent production deployer.
IMPROVEMENT_PRODUCTION_GOVERNANCE_MIN_APPROVALS=2
IMPROVEMENT_PRODUCTION_GOVERNANCE_REQUIRED_ROLES=release-manager,ops
IMPROVEMENT_PRODUCTION_GOVERNANCE_ALLOWED_APPROVER_ROLES=release-manager,ops,security,maintainer
IMPROVEMENT_PRODUCTION_GOVERNANCE_CREATOR_ROLES=release-manager,maintainer
IMPROVEMENT_PRODUCTION_GOVERNANCE_EDITOR_ROLES=release-manager,maintainer,ops
IMPROVEMENT_PRODUCTION_GOVERNANCE_TRAIN_ROLES=release-manager,ops
IMPROVEMENT_PRODUCTION_GOVERNANCE_LOCK_ROLES=release-manager
IMPROVEMENT_PRODUCTION_GOVERNANCE_PACKAGE_ROLES=release-manager,ops
IMPROVEMENT_PRODUCTION_GOVERNANCE_CHANGE_TICKET_REQUIRED=true
IMPROVEMENT_PRODUCTION_GOVERNANCE_CHANGE_TICKET_PATTERN=^[A-Z][A-Z0-9]+-[0-9]+$
IMPROVEMENT_PRODUCTION_GOVERNANCE_FREEZE_WINDOWS_JSON=[]
IMPROVEMENT_PRODUCTION_GOVERNANCE_DEFAULT_TIMEZONE=UTC
IMPROVEMENT_PRODUCTION_GOVERNANCE_RELEASE_TRAIN_REQUIRED=false
IMPROVEMENT_PRODUCTION_GOVERNANCE_RELEASE_TRAIN_WINDOW_REQUIRED=false
IMPROVEMENT_PRODUCTION_GOVERNANCE_LOCK_REQUIRE_SIGNATURE=true
IMPROVEMENT_PRODUCTION_GOVERNANCE_PACKAGE_REQUIRE_SIGNATURE=true
IMPROVEMENT_PRODUCTION_GOVERNANCE_DEPLOYER_AUDIENCE=independent-production-deployer


# Part 15 independent production deployer handoff + production outcome learning
# AI backend still has no production credentials or production executor.
IMPROVEMENT_PRODUCTION_GOVERNANCE_ARTIFACT_BINDING_REQUIRED=true
IMPROVEMENT_PRODUCTION_AUTHORIZATION_TTL_MINUTES=10
IMPROVEMENT_PRODUCTION_AUTHORIZATION_ROLES=release-manager,ops
# Must match PRODUCTION_DEPLOYER_RECEIPT_SIGNING_KEY to accept signed deployer receipts.
IMPROVEMENT_PRODUCTION_OUTCOME_SIGNING_KEY=
IMPROVEMENT_PRODUCTION_OUTCOME_MAX_BYTES=1000000
IMPROVEMENT_PRODUCTION_LEARNING_LOOKBACK=100
IMPROVEMENT_PRODUCTION_LEARNING_ROLLBACK_PENALTY=0.35

# Independent production deployer (separate trust boundary)
PRODUCTION_DEPLOYER_EXECUTION_ENABLED=false
# Must match the release/governance signing key used to sign Part 14 packages/authorizations.
PRODUCTION_DEPLOYER_PACKAGE_SIGNING_KEY=
# Separate deployer-owned key used to sign production deployment receipts.
PRODUCTION_DEPLOYER_RECEIPT_SIGNING_KEY=
PRODUCTION_DEPLOYER_OPERATOR_CREDENTIALS_JSON={}
PRODUCTION_DEPLOYER_ALLOWED_OPERATOR_ROLES=release-manager,ops,deployer
PRODUCTION_DEPLOYER_AUTO_ROLLBACK_ENABLED=true
PRODUCTION_DEPLOYER_OUTCOME_CALLBACK_URL=http://backend:8000/improvements/production-outcomes
PRODUCTION_DEPLOYER_ALLOW_HTTP_CALLBACK=true

# Part 16 production hardening / certification
IMPROVEMENT_PRODUCTION_OUTCOME_PREVIOUS_SIGNING_KEYS=
IMPROVEMENT_CERTIFICATION_SIGNING_KEY=
IMPROVEMENT_CERTIFICATION_MAX_EVIDENCE_AGE_HOURS=168
IMPROVEMENT_CERTIFICATION_REQUIRED_GATES=deployer_tests,migration_safety,key_rotation,slo_window,rollback_drill,chaos_failover,security_attack,audit_chain,load_concurrency
IMPROVEMENT_CERTIFICATION_MIN_PRODUCTION_SUCCESS_RATE=0.80
IMPROVEMENT_CERTIFICATION_MAX_ROLLBACK_RATE=0.20
